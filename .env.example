# 개발용 데이터베이스 이름: 팀 공통 설정
MYSQL_DATABASE=kmanual_dev

# 백엔드 앱이 접속할 계정 이름: 팀 공통 설정
MYSQL_USER=kmanual_app

# 앱 계정 비밀번호: 각자 정해 .env에 입력 (컨테이너 실행 전에 반드시 채우기)
MYSQL_PASSWORD=replace_with_local_app_password

# MySQL 관리자(root) 비밀번호: 각자 정해 .env에 입력 (컨테이너 실행 전에 반드시 채우기)
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# 내 PC에서 접속할 포트: 기본값 3307, 이미 사용 중이면 변경
MYSQL_PORT=3307
